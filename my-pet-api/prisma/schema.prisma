generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  lastname     String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  phone        String?
  address      String?

  // --- CONTACTOS DE EMERGENCIA (pantalla Mi Perfil) ---
  vetName        String?
  vetPhone       String?
  emergencyPhone String?

  // --- CONSENTIMIENTO (Ley 25.326): qué versión de Términos y Privacidad aceptó y cuándo ---
  termsAcceptedAt DateTime?
  termsVersion    String? // ver TERMS_VERSION en src/lib/legal.ts

  // --- PREFERENCIAS ---
  emailReminders Boolean @default(true) // recordatorios de vacunas/desparasitaciones por email

  // --- SUSCRIPCIÓN (ver src/lib/subscription.ts) ---
  trialEndsAt   DateTime? // fin de la prueba gratis; null = usuario previo (se completa solo al consultar)
  plan          Plan? // plan pago; null = sin plan
  planExpiresAt DateTime? // el plan pago vale hasta esta fecha

  // --- NUEVOS CAMPOS PARA VERIFICACIÓN DE EMAIL ---
  isVerified             Boolean   @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?

  // --- CAMPOS PARA RECUPERAR CONTRASEÑA (los usaremos para el código de 6 dígitos) ---
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  pets              Pet[]
  memberships       PetMember[] // mascotas que otra persona compartió con este usuario
  clinicMemberships ClinicMember[] // veterinarias de las que forma parte (ver sección CLÍNICAS)
}

model Pet {
  id                  String          @id @default(cuid())
  name                String
  species             Species
  breed               String?
  gender              String?
  birthDate           DateTime?
  isCastrated         Boolean         @default(false)
  specialNeeds        String?
  ownerId             String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  bannerImageUrl      String?
  profileImageUrl     String?
  weight              String?
  showPhonePublicly   Boolean         @default(false)
  showAddressPublicly Boolean         @default(false)
  // --- MODO MASCOTA PERDIDA ---
  isLost              Boolean         @default(false)
  lostSince           DateTime?
  lostMessage         String?
  attachments         Attachment[]
  dewormings          Deworming[]
  weights             WeightRecord[]
  treatments          Treatment[]
  medicalHistory      MedicalRecord[]
  owner               User            @relation(fields: [ownerId], references: [id])
  vaccinations        Vaccination[]
  members             PetMember[] // familiares con acceso (ver src/lib/access.ts)
  shareLinks          ShareLink[] // invitaciones y links para el veterinario
}

// ==========================================================
// COMPARTIR MASCOTAS
// - PetMember: un familiar que acepta una invitación puede ver y cargar registros.
//   No puede borrar la mascota ni manejar los accesos (eso queda para el dueño).
// - ShareLink FAMILY: link de invitación de un solo uso (vence a los 7 días).
// - ShareLink VET: link de solo lectura de la ficha, sin cuenta (vence a los 7 días, revocable).
// ==========================================================
model PetMember {
  id        String   @id @default(cuid())
  petId     String
  userId    String
  createdAt DateTime @default(now())
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([petId, userId])
  @@index([userId])
}

model ShareLink {
  id        String    @id @default(cuid())
  petId     String
  kind      ShareKind
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  usedAt    DateTime? // solo FAMILY: cuándo se aceptó
  usedById  String?
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

enum ShareKind {
  FAMILY
  VET
}

model Vaccination {
  id             String    @id @default(cuid())
  name           String
  dateApplied    DateTime
  nextDueDate    DateTime?
  reminderSentAt DateTime? // cuándo se avisó por email del vencimiento (null = pendiente)
  notes          String?
  petId          String
  pet            Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id          String       @id @default(cuid())
  date        DateTime     @default(now())
  title       String
  description String
  petId       String
  attachments Attachment[]
  pet         Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Attachment {
  id              String         @id @default(cuid())
  url             String
  fileType        String
  name            String
  createdAt       DateTime       @default(now())
  medicalRecordId String?
  petId           String
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  pet             Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
}

// Medicación y tratamientos. endDate null = tratamiento continuo (crónico)
model Treatment {
  id             String    @id @default(cuid())
  name           String // medicamento
  dose           String? // ej: "1/2 comprimido", "5 ml"
  frequencyHours Int // cada cuántas horas: 6, 8, 12, 24, 48, 168...
  startDate      DateTime
  endDate        DateTime?
  notes          String?
  petId          String
  createdAt      DateTime  @default(now())
  pet            Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

// Historial de peso. Pet.weight guarda el valor del registro más reciente (lo sincroniza routes/weights.ts)
model WeightRecord {
  id        String   @id @default(cuid())
  weightKg  Float
  date      DateTime
  note      String?
  petId     String
  createdAt DateTime @default(now())
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, date])
}

model Deworming {
  id             String    @id @default(cuid())
  name           String
  dateApplied    DateTime
  nextDueDate    DateTime?
  reminderSentAt DateTime? // cuándo se avisó por email del vencimiento (null = pendiente)
  type           String
  petId          String
  createdAt      DateTime  @default(now())
  pet            Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
}

enum Plan {
  STANDARD
  PRO
}

enum Role {
  USER
  ADMIN
}

enum Species {
  CAT
  DOG
  BIRD // aves: canarios, cotorras, loros...
  RABBIT
  RODENT // hámster, cobayo, chinchilla, ratón...
  FERRET
  REPTILE // tortugas, iguanas, geckos...
  FISH
  HORSE
  OTHER
}

// ==========================================================
// CLÍNICAS VETERINARIAS (sección /clinica) — ver src/lib/clinic.ts
// La clínica tiene su propia base de clientes y pacientes, separada de las
// mascotas de los dueños (el vínculo con la app del dueño llega más adelante).
// Cada veterinario carga su matrícula y un administrador la aprueba a mano.
// ==========================================================

enum ClinicRole {
  OWNER // quien registró la clínica: maneja el equipo y los datos de la clínica
  VET // veterinario con matrícula
  STAFF // recepción / asistente: clientes y pacientes, sin cargar historia clínica
}

enum LicenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClinicalRecordType {
  CONSULTATION
  CONTROL
  EMERGENCY
  SURGERY
  OTHER
}

enum PreventiveKind {
  VACCINE
  DEWORMING
}

model Clinic {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  province    String
  phone       String
  email       String?
  logoUrl     String?
  trialEndsAt DateTime // prueba gratis de la clínica (el plan propio se define más adelante)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ClinicMember[]
  invites     ClinicInvite[]
  clients     ClinicClient[]
  patients    ClinicPatient[]
  records     ClinicalRecord[]
  preventives ClinicPreventive[]
  attachments ClinicAttachment[]
}

model ClinicMember {
  id                String         @id @default(cuid())
  clinicId          String
  userId            String
  role              ClinicRole
  // Matrícula (OWNER y VET). El carnet se guarda en Cloudinary como archivo privado:
  // solo se ve con una URL firmada que genera el admin.
  licenseNumber     String?
  licenseIssuer     String? // colegio o provincia que la emite
  licensePhotoId    String? // public_id de Cloudinary (type: authenticated)
  licenseStatus     LicenseStatus?
  licenseNote       String? // motivo del rechazo
  licenseReviewedAt DateTime?
  createdAt         DateTime       @default(now())

  clinic  Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  records ClinicalRecord[]

  @@unique([clinicId, userId])
  @@index([userId])
  @@index([licenseStatus])
}

model ClinicInvite {
  id        String     @id @default(cuid())
  clinicId  String
  role      ClinicRole // VET o STAFF
  token     String     @unique
  createdAt DateTime   @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  usedAt    DateTime?
  usedById  String?
  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model ClinicClient {
  id        String          @id @default(cuid())
  clinicId  String
  name      String
  lastname  String
  dni       String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  clinic    Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patients  ClinicPatient[]

  @@index([clinicId, lastname])
}

model ClinicPatient {
  id          String    @id @default(cuid())
  clinicId    String
  clientId    String
  name        String
  species     Species
  breed       String?
  sex         String? // "Macho" | "Hembra"
  birthDate   DateTime?
  coat        String? // pelaje y señas particulares
  microchip   String?
  isCastrated Boolean   @default(false)
  weightKg    Float? // último peso (se actualiza con cada consulta)
  alerts      String? // alergias, agresivo, cardíaco... (siempre visible)
  deceasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic      Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  client      ClinicClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  records     ClinicalRecord[]
  preventives ClinicPreventive[]
  attachments ClinicAttachment[]

  @@index([clinicId, name])
  @@index([clientId])
}

// Consulta / historia clínica
model ClinicalRecord {
  id              String             @id @default(cuid())
  clinicId        String
  patientId       String
  authorId        String? // ClinicMember que la cargó (null si después lo quitan del equipo)
  date            DateTime
  type            ClinicalRecordType @default(CONSULTATION)
  reason          String
  anamnesis       String?
  // Examen físico
  weightKg        Float?
  temperatureC    Float?
  heartRate       Int? // lpm
  respiratoryRate Int? // rpm
  mucous          String? // mucosas: rosadas, pálidas...
  capillaryRefill String? // TLLC
  hydration       String?
  bodyCondition   Int? // 1 a 9
  physicalExam    String?
  // Diagnóstico y tratamiento
  presumptiveDx   String?
  finalDx         String?
  treatment       String?
  nextControl     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  clinic  Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author  ClinicMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([patientId, date])
  @@index([clinicId, date])
}

// Vacunas y desparasitaciones aplicadas en la clínica
model ClinicPreventive {
  id          String         @id @default(cuid())
  clinicId    String
  patientId   String
  kind        PreventiveKind
  name        String
  lot         String?
  route       String? // desparasitación: INTERNA | EXTERNA
  dateApplied DateTime
  nextDueDate DateTime?
  authorId    String?
  createdAt   DateTime       @default(now())

  clinic  Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([clinicId, nextDueDate])
}

model ClinicAttachment {
  id           String   @id @default(cuid())
  clinicId     String
  patientId    String
  name         String
  url          String
  fileType     String
  uploadedById String?
  createdAt    DateTime @default(now())

  clinic  Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient ClinicPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}
